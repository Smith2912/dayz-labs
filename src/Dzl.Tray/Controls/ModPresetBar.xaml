<UserControl x:Class="Dzl.Tray.Controls.ModPresetBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dzl.Tray.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="ModPresetBoolToVis" />
  </UserControl.Resources>
  <!-- Mod-preset (loadout) bar. Selecting in the combo applies the loadout immediately;
       "(modified)" appears when the live loadout has drifted from the selected preset. -->
  <StackPanel Orientation="Horizontal">
    <TextBlock Text="Preset:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    <ComboBox MinWidth="150" VerticalAlignment="Center"
              ToolTip="Apply a saved mod loadout to this server (takes effect on next start)"
              ItemsSource="{Binding ModPresetNames}"
              SelectedItem="{Binding SelectedModPreset, Mode=TwoWay}" />
    <TextBlock Text="(modified)" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
               ToolTip="The loadout has been edited since this preset was applied — use ⋯ → Update preset to save the changes"
               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
               Visibility="{Binding ModPresetModified, Converter={StaticResource ModPresetBoolToVis}}" />
    <ui:TextBox Width="140" VerticalAlignment="Center" Margin="10,0,0,0"
                PlaceholderText="save as…"
                Text="{Binding NewModPresetName, UpdateSourceTrigger=PropertyChanged}" />
    <ui:Button Icon="{ui:SymbolIcon Save24}" ToolTip="Save the current loadout as a new preset"
               Margin="6,0,0,0" Command="{Binding SaveModPresetAsCommand}" />
    <ui:DropDownButton Icon="{ui:SymbolIcon MoreHorizontal24}" ToolTip="Preset actions" Margin="6,0,0,0">
      <ui:DropDownButton.Flyout>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="Update preset with current loadout" Command="{Binding UpdateModPresetCommand}">
            <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Delete preset" Command="{Binding DeleteModPresetCommand}">
            <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </ui:DropDownButton.Flyout>
    </ui:DropDownButton>
  </StackPanel>
</UserControl>
